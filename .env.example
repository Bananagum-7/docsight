# Free key: https://console.groq.com  (model names change; check the console)
GROQ_API_KEY=
DOCSIGHT_ANSWER_MODEL=llama-3.3-70b-versatile
DOCSIGHT_FAST_MODEL=llama-3.1-8b-instant
# Judge from a different model family than the answer model, to reduce self-preference bias
DOCSIGHT_JUDGE_MODEL=openai/gpt-oss-120b

# Optional tracing: https://cloud.langfuse.com (free hobby tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
